# Chaîne de connexion PostgreSQL fournie par votre hébergeur de base de données.
DATABASE_URL=postgresql://utilisateur:mot-de-passe@hote:5432/tekasafe

# true pour une base en ligne utilisant SSL, false pour PostgreSQL installé sur ce PC.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20
DATABASE_PORT=5432

# À laisser à true uniquement pendant les démonstrations locales : le code OTP 1234 sera affiché à l’écran.
DEMO_MODE=true

# Numéros autorisés à administrer l’application, séparés par des virgules. Laisser vide en démo.
ADMIN_PHONE_NUMBERS=

# Remplacez cette phrase par une longue valeur privée avant tout déploiement.
OTP_SECRET=changez-cette-valeur-par-un-secret-long-et-prive
PORT=4173
NODE_ENV=development
